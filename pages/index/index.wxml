<navigation-bar title="省份查询" background="transparent" color="#fff"></navigation-bar>

<view class="container">
  <view class="search-card">
    <view class="title">省会查询</view>
    <view class="search-box">
      <input 
        class="search-input" 
        placeholder="请输入查询的省份" 
        placeholder-class="placeholder-style"
        bindinput="onInput"
        value="{{keyword}}" />
     <button class="search-btn" bindtap="search">查询</button>
    </view>
  </view>
</view>